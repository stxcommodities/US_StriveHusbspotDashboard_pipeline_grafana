{
  "title": "Pipeline Dashboard",
  "uid": "pipeline-dashboard",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "hubspot",
    "pipeline"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "postgres",
        "current": {},
        "hide": 0,
        "label": "Postgres data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total deals",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Total deals\" FROM hubspot_us.deals_snapshot",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background_solid"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#28695a"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Total pipeline value",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "rawSql": "SELECT coalesce(sum(amount), 0) AS \"Total value\" FROM hubspot_us.deals_snapshot WHERE NOT is_closed",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background_solid"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#28695a"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Weighted value",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "rawSql": "SELECT coalesce(sum(weighted_amount), 0) AS \"Weighted value\" FROM hubspot_us.deals_snapshot WHERE NOT is_closed",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background_solid"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#28695a"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Changed (selected time range)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Changes\" FROM hubspot_us.deal_stage_events WHERE changed_at BETWEEN $__timeFrom() AND $__timeTo()",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background_solid"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#b8863b"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Deals by stage",
      "type": "barchart",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "rawSql": "SELECT coalesce(count(*) FILTER (WHERE stage_label = 'Discovery Initiated'), 0) AS \"Discovery Initiated\", coalesce(count(*) FILTER (WHERE stage_label = 'Discovery Completed'), 0) AS \"Discovery Completed\", coalesce(count(*) FILTER (WHERE stage_label = 'Parked Deals'), 0) AS \"Parked Deals\", coalesce(count(*) FILTER (WHERE stage_label = 'Negotiations Initiated'), 0) AS \"Negotiations Initiated\", coalesce(count(*) FILTER (WHERE stage_label = 'Contracting Initiated'), 0) AS \"Contracting Initiated\", coalesce(count(*) FILTER (WHERE stage_label = 'Closed Won'), 0) AS \"Closed Won\", coalesce(count(*) FILTER (WHERE stage_label = 'Closed Lost'), 0) AS \"Closed Lost\" FROM hubspot_us.deals_snapshot",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Discovery Initiated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6b8b9e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Discovery Completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3f8a76"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Parked Deals"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c08a3e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Negotiations Initiated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#a05a7a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Contracting Initiated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7a6bb0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Closed Won"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2f8f5b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Closed Lost"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b7473a"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "What changed",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "rawSql": "SELECT \"Time\", \"Deal\", \"Event\", \"Stage before\", \"Stage after\", \"Amount\" FROM (SELECT changed_at AS \"Time\", deal_name AS \"Deal\", event_type AS \"Event\", LAG(stage_label) OVER (PARTITION BY deal_id ORDER BY changed_at) AS \"Stage before\", stage_label AS \"Stage after\", amount AS \"Amount\" FROM hubspot_us.deal_stage_events) sub WHERE \"Time\" BETWEEN $__timeFrom() AND $__timeTo() ORDER BY \"Time\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Stage before"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Discovery Initiated": {
                        "color": "#6b8b9e",
                        "index": 0
                      },
                      "Discovery Completed": {
                        "color": "#3f8a76",
                        "index": 1
                      },
                      "Parked Deals": {
                        "color": "#c08a3e",
                        "index": 2
                      },
                      "Negotiations Initiated": {
                        "color": "#a05a7a",
                        "index": 3
                      },
                      "Contracting Initiated": {
                        "color": "#7a6bb0",
                        "index": 4
                      },
                      "Closed Won": {
                        "color": "#2f8f5b",
                        "index": 5
                      },
                      "Closed Lost": {
                        "color": "#b7473a",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Stage after"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Discovery Initiated": {
                        "color": "#6b8b9e",
                        "index": 0
                      },
                      "Discovery Completed": {
                        "color": "#3f8a76",
                        "index": 1
                      },
                      "Parked Deals": {
                        "color": "#c08a3e",
                        "index": 2
                      },
                      "Negotiations Initiated": {
                        "color": "#a05a7a",
                        "index": 3
                      },
                      "Contracting Initiated": {
                        "color": "#7a6bb0",
                        "index": 4
                      },
                      "Closed Won": {
                        "color": "#2f8f5b",
                        "index": 5
                      },
                      "Closed Lost": {
                        "color": "#b7473a",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
